# das2go -- tier 20 -- DAS server (Go)
git-https://github.com/dmwm/das2go.git

# dasgoclient -- tier 20 -- dasgoclient, the DAS command-line client
git-https://github.com/dmwm/dasgoclient.git

# dbsclient -- tier 20 -- DBS3 Python client
git-https://github.com/dmwm/DBSClient.git

# rucio -- tier 20 -- Rucio (server, client, daemons); 952 files unscoped
git-https://github.com/rucio/rucio.git

# wmcore -- tier 20 -- WMCore libraries CRAB runs on; WMExceptions.py holds the WM exit codes
git-https://github.com/dmwm/WMCore.git

# monitoringscripts -- tier 20 -- CMS Computing Operations monitoring scripts (site readiness, SAM, metrics)
git-https://github.com/CMSCompOps/MonitoringScripts.git

# lpc-scripts -- tier 20 -- FNAL LPC user helper scripts (condor submission, EOS, environment)
git-https://github.com/FNALLPC/lpc-scripts.git

# fts3 -- tier 20 -- FTS3 file transfer service (the transfers behind Rucio and CRAB stageout)
git-https://github.com/cern-fts/fts3.git

# dbs -- tier 20 -- DBS3 server (Python), the dataset bookkeeping service
git-https://github.com/dmwm/DBS.git

# dbs2go -- tier 20 -- DBS server in Go (the current production DBS)
git-https://github.com/dmwm/dbs2go.git

# cmsmonitoring -- tier 20 -- CMS monitoring infrastructure (MONIT, dashboards, CRAB/WMAgent metrics)
git-https://github.com/dmwm/CMSMonitoring.git

# crabserver-wiki -- tier 20 -- CRABServer GitHub wiki -- developer and operator notes not in the code or the TWiki
git-https://github.com/dmwm/CRABServer.wiki.git

# wmcore-wiki -- tier 20 -- WMCore GitHub wiki -- WMAgent operations, error handling, background of the WM exit codes
git-https://github.com/dmwm/WMCore.wiki.git

# rucio-docs -- tier 20 -- Rucio user and operator documentation ("how do I"; the rucio repo is "where in the code")
git-https://github.com/rucio/documentation.git

# cms-docker -- tier 20 -- cms-sw container images (cmssw-el7/el8/el9 Dockerfiles, locale and tool choices behind "command not found" in a container)
git-https://github.com/cms-sw/cms-docker.git

# cmssw-osenv -- tier 20 -- the cmssw-env wrapper behind cmssw-el7/el8/el9 (apptainer, bind mounts, LC_ALL, --command-to-run)
git-https://github.com/cms-sw/cmssw-osenv.git

# cmssw-wm-tools -- tier 20 -- edm_pset_tweak and the other scripts WMCore/CRAB use to rewrite a PSet at runtime
git-https://github.com/cms-sw/cmssw-wm-tools.git

# nanoaod-tools -- tier 20 -- NanoAODTools post-processor (crab/ example, crabhelper.py, fwkJobReport handling)
git-https://github.com/cms-nanoAOD/nanoAOD-tools.git

# cms-cat-cmssw-lxplus -- tier 20 -- cms-cat/cmssw-lxplus -- running CMSSW on lxplus9 for pre-el9 releases
git-https://gitlab.cern.ch/cms-cat/cmssw-lxplus.git

